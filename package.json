{
  "name": "warpdom",
  "version": "0.1.12",
  "description": "A fast DOM for unit and component tests: jsdom's test results, faster. A drop-in Vitest and Jest environment.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Sonu Kapoor",
    "url": "https://github.com/sonukapoor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonukapoor/warpdom.git"
  },
  "homepage": "https://github.com/sonukapoor/warpdom#readme",
  "bugs": {
    "url": "https://github.com/sonukapoor/warpdom/issues"
  },
  "keywords": [
    "dom",
    "jsdom",
    "testing",
    "vitest",
    "jest",
    "test-environment",
    "happy-dom",
    "web-platform",
    "whatwg",
    "vitest-environment",
    "jest-environment",
    "dom-testing",
    "unit-testing",
    "component-testing",
    "jsdom-alternative",
    "happy-dom-alternative",
    "html",
    "css",
    "getcomputedstyle",
    "web-platform-tests",
    "fast"
  ],
  "main": "./dist/warpdom.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "module-sync": {
          "types": "./types/index.d.ts",
          "default": "./src/node.js"
        },
        "require": {
          "types": "./dist/warpdom.d.cts",
          "default": "./dist/warpdom.cjs"
        },
        "default": {
          "types": "./types/index.d.ts",
          "default": "./src/node.js"
        }
      },
      "require": {
        "types": "./dist/warpdom.d.cts",
        "default": "./dist/warpdom.cjs"
      },
      "default": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./vitest": {
      "types": "./types/vitest.d.ts",
      "default": "./src/vitest.js"
    },
    "./vitest/environment": {
      "types": "./types/vitest-environment.d.ts",
      "default": "./src/vitest-environment.js"
    },
    "./vitest/reset": {
      "types": "./types/vitest-reset.d.ts",
      "default": "./src/vitest-reset.js"
    },
    "./vitest/fast": {
      "types": "./types/vitest-fast.d.ts",
      "default": "./src/vitest-fast.js"
    },
    "./jest": {
      "types": "./types/jest.d.ts",
      "default": "./src/jest.js"
    },
    "./compare": {
      "types": "./types/compare.d.ts",
      "default": "./src/compare/index.js"
    },
    "./migrate": {
      "types": "./types/migrate.d.ts",
      "default": "./src/migrate/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build-cjs.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\" test/parity.js",
    "bench:load": "node bench/load.js",
    "bench:hot": "node bench/hot.js",
    "test:types": "npm run build && tsc -p test/types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@acemir/cssom": "file:test/fixtures/acemir-cssom-slot",
    "@happy-dom/jest-environment": "^20.14.6",
    "@webref/css": "^8.7.6",
    "@webref/elements": "^2.9.1",
    "@webref/idl": "^3.85.1",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "jsdom20": "npm:jsdom@20.0.3",
    "jsdom21": "npm:jsdom@21.1.2",
    "jsdom22": "npm:jsdom@22.1.0",
    "jsdom23": "npm:jsdom@23.2.0",
    "jsdom24": "npm:jsdom@24.1.3",
    "jsdom25": "npm:jsdom@25.0.1",
    "jsdom26": "npm:jsdom@^26.1.0",
    "jsdom27": "npm:jsdom@27.4.0",
    "jsdom28": "npm:jsdom@28.1.0",
    "jsdom29": "npm:jsdom@29.1.1",
    "jsdom30": "npm:jsdom@30.1.3",
    "msw": "^3.0.3",
    "nock": "^14.0.17",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jsdom25": {
      "cssstyle": "4.1.0"
    },
    "jsdom": {
      ".": "$jsdom",
      "undici": "8.11.2"
    }
  },
  "dependencies": {
    "@rgrove/parse-xml": "^5.0.0",
    "parse5": "^8.0.1"
  },
  "bin": {
    "warpdom": "bin/warpdom.js"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
