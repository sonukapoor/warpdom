{
  "name": "warpdom",
  "version": "0.1.4",
  "description": "A fast DOM for unit and component tests: jsdom's test results, faster. A drop-in Vitest and Jest environment.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Sonu Kapoor",
    "url": "https://github.com/sonukapoor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonukapoor/warpdom.git"
  },
  "homepage": "https://github.com/sonukapoor/warpdom#readme",
  "bugs": {
    "url": "https://github.com/sonukapoor/warpdom/issues"
  },
  "keywords": [
    "dom",
    "jsdom",
    "testing",
    "vitest",
    "jest",
    "test-environment",
    "happy-dom",
    "web-platform",
    "whatwg",
    "vitest-environment",
    "jest-environment"
  ],
  "main": "./src/node.js",
  "exports": {
    ".": {
      "node": "./src/node.js",
      "default": "./src/index.js"
    },
    "./vitest": "./src/vitest.js",
    "./vitest/environment": "./src/vitest-environment.js",
    "./vitest/reset": "./src/vitest-reset.js",
    "./vitest/fast": "./src/vitest-fast.js",
    "./jest": "./src/jest.js",
    "./compare": "./src/compare/index.js",
    "./migrate": "./src/migrate/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" test/parity.js",
    "bench:load": "node bench/load.js",
    "bench:hot": "node bench/hot.js"
  },
  "devDependencies": {
    "@happy-dom/jest-environment": "^20.14.6",
    "@webref/css": "^8.7.6",
    "@webref/elements": "^2.9.1",
    "@webref/idl": "^3.85.1",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "jsdom20": "npm:jsdom@20.0.3",
    "jsdom22": "npm:jsdom@22.1.0",
    "jsdom25": "npm:jsdom@25.0.1",
    "jsdom26": "npm:jsdom@^26.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jsdom25": {
      "cssstyle": "4.1.0"
    }
  },
  "dependencies": {
    "@rgrove/parse-xml": "^5.0.0",
    "parse5": "^8.0.1"
  },
  "bin": {
    "warpdom": "bin/warpdom.js"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
