{
  "name": "warpdom",
  "version": "0.0.0",
  "description": "A DOM for unit tests that loads almost instantly and behaves like jsdom.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Sonu Kapoor",
  "exports": {
    ".": {
      "node": "./src/node.js",
      "default": "./src/index.js"
    },
    "./vitest": "./src/vitest.js",
    "./vitest/environment": "./src/vitest-environment.js",
    "./vitest/reset": "./src/vitest-reset.js",
    "./vitest/fast": "./src/vitest-fast.js",
    "./jest": "./src/jest.js",
    "./compare": "./src/compare/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test",
    "bench:load": "node bench/load.js",
    "bench:hot": "node bench/hot.js"
  },
  "devDependencies": {
    "@webref/css": "^8.7.6",
    "@webref/elements": "^2.9.1",
    "@webref/idl": "^3.85.1",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "jsdom25": "npm:jsdom@25.0.1",
    "jsdom26": "npm:jsdom@^26.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "jsdom25": {
      "cssstyle": "4.1.0"
    }
  },
  "dependencies": {
    "@rgrove/parse-xml": "^5.0.0",
    "parse5": "^8.0.1"
  },
  "bin": {
    "warpdom": "./bin/warpdom.js"
  }
}
